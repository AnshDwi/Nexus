{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "crons": [
    {
      "path": "/api/v1/internal/maintenance",
      "schedule": "17 3 * * *"
    }
  ],
  "daemons": {
    "scheduler": {
      "root": "./",
      "entrypoint": "Dockerfile",
      "command": [
        "python",
        "-m",
        "nexus.daemon",
        "scheduler"
      ],
      "instances": {
        "iad1": 2
      },
      "livenessProbe": {
        "httpGet": {
          "port": 8081,
          "path": "/health"
        },
        "initialDelaySeconds": 20,
        "periodSeconds": 15,
        "timeoutSeconds": 3,
        "failureThreshold": 4
      },
      "terminationGracePeriodSeconds": 30
    }
  }
}
