# NEXUS production configuration for compose.production.yml.
#
# Easiest: `deploy/production/nexus.sh init nexus.example.com you@example.com`
# writes .env.production with fresh random secrets and prints your first API
# key. To do it by hand, copy this file to .env.production (never commit it)
# and replace every CHANGE-ME. Generate secrets with:  openssl rand -hex 32

# --- Public address ---------------------------------------------------------
# DNS A/AAAA record of this name must point at the server; Caddy gets the
# TLS certificate automatically using this e-mail for Let's Encrypt.
NEXUS_DOMAIN=CHANGE-ME.example.com
ACME_EMAIL=CHANGE-ME@example.com

# --- Data stores (internal network only) ------------------------------------
POSTGRES_USER=nexus
POSTGRES_DB=nexus
POSTGRES_PASSWORD=CHANGE-ME
RABBITMQ_USER=nexus
RABBITMQ_PASSWORD=CHANGE-ME
REDIS_PASSWORD=CHANGE-ME

# --- API access -------------------------------------------------------------
# Comma-separated "tenant:sha256(key)". Create one with:
#   deploy/production/nexus.sh new-key <tenant>
# The key itself is shown once; only its hash goes here.
API_KEYS=CHANGE-ME
# Shared secrets for /api/v1/internal/* (never exposed publicly by Caddy).
CRON_SECRET=CHANGE-ME
METRICS_TOKEN=CHANGE-ME
GRAFANA_ADMIN_PASSWORD=CHANGE-ME

# --- Capacity ---------------------------------------------------------------
WORKER_REPLICAS=2
WORKER_CAPACITY=4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Behaviour (defaults shown) ---------------------------------------------
# Hosts http.webhook jobs may call (https only), comma-separated.
WEBHOOK_ALLOWED_HOSTS=
# Only for a browser dashboard on ANOTHER origin; https origins only.
CORS_ALLOWED_ORIGINS=
# test.sleep / test.flaky / test.fail job types. Leave false in production;
# set true temporarily to run the demo seed or the resilience suite.
TASK_ENABLE_TEST_HANDLERS=false
JOB_DEFAULT_TIMEOUT_SECONDS=60
JOB_DEFAULT_MAX_ATTEMPTS=3
RATE_LIMIT_READS_PER_MINUTE=600
RATE_LIMIT_WRITES_PER_MINUTE=120
PROMETHEUS_RETENTION=15d

# NEXUS_VERSION is set by `nexus.sh deploy` (git commit); don't set it here.
