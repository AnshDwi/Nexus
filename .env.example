# ---------------------------------------------------------------------------
# Local development. On Vercel, set these as Project Environment Variables
# (mark secrets "Sensitive"); Marketplace integrations inject DATABASE_URL /
# REDIS_URL automatically. VERCEL_ENV / VERCEL_REGION / VERCEL_DEPLOYMENT_ID
# are set by Vercel.
# ---------------------------------------------------------------------------
APP_NAME=nexus
ENVIRONMENT=local
DEBUG=false

# PostgreSQL: either a provider URL...
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# ...or discrete fields (local):
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Messaging: rabbitmq (default) | vercel_queues | none
EVENT_BUS=rabbitmq
# Either a full URL (managed brokers such as CloudAMQP: amqps://...) ...
# RABBITMQ_URL=amqps://user:pass@host/vhost
# ... or discrete fields (local):
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=nexus
RABBITMQ_PASSWORD=nexus

# Redis: shared rate-limit counters (optional; falls back to in-process)
REDIS_URL=redis://localhost:6379/0

# Only for EVENT_BUS=vercel_queues (local: python -m vercel.queue.devserver --port 9100)
# VERCEL_QUEUE_BASE_URL=http://127.0.0.1:9100
# VERCEL_QUEUE_TOKEN=local-token
# VERCEL_QUEUE_REGION=iad1
# VERCEL_QUEUE_DEPLOYMENT=all

# Browser origins allowed to call the API (the dashboard), comma-separated.
# Not needed locally (Vite proxies /api). Production: https:// origins only.
# CORS_ALLOWED_ORIGINS=https://nexus-dashboard.vercel.app
RATE_LIMIT_READS_PER_MINUTE=600
RATE_LIMIT_WRITES_PER_MINUTE=120

# Workers
WORKER_CAPACITY=4
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=30
WORKER_SHUTDOWN_GRACE_SECONDS=25
JOB_DEFAULT_TIMEOUT_SECONDS=60
JOB_MAX_TIMEOUT_SECONDS=3600
JOB_DEFAULT_MAX_ATTEMPTS=3

# Auth: comma-separated "tenant_id:sha256(key)". Generate with
#   uv run python -m nexus.cli new-api-key <tenant_id>
# Local example key "dev-key" for tenant "dev":
API_KEYS=dev:7e9f8fd111802be56c379d597842e29b2cebd35ff2133d431a49fa556a18704e
CRON_SECRET=local-cron-secret
# METRICS_TOKEN=

# Execution
TASK_DEFAULT_TIMEOUT_SECONDS=60
TASK_MAX_TIMEOUT_SECONDS=240
TASK_ENABLE_TEST_HANDLERS=true
# WEBHOOK_ALLOWED_HOSTS=hooks.example.com
